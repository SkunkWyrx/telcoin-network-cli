# Copy to a private .env file and fill in the administrator's key paths and CIDR.
# The fleet supplies network, image, resource group and blank/snapshot disk settings.
VM_NAME=mainnet-observer-1
VM_DNS_LABEL=oprail-mainnet-observer-1
VM_SIZE=Standard_D4s_v6
VM_ZONE=1
DATA_DISK_IOPS=5000
DATA_DISK_MBPS=125
VM_ADMIN_USERNAME=azureuser
SSH_SOURCE_CIDR=REPLACE_WITH_ADMIN_CIDR
SSH_PUBLIC_KEY_FILE=/absolute/path/to/id_ed25519.pub
SSH_PRIVATE_KEY_FILE=/absolute/path/to/id_ed25519
TN_BLS_PASSPHRASE=REPLACE_WITH_UNIQUE_RANDOM_SECRET
HTTP_API=eth,net,web3,rpc,debug,trace
WS_ENABLED=true
WS_API=eth,net,web3,rpc,debug,trace
