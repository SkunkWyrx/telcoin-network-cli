# Telcoin Network Observer Node - Environment Variables
# 
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# The .env file is git-ignored and will not be committed to the repository.
# Never commit secrets or passphrases to version control!

# ============================================================================
# Required for Non-Interactive Mode
# ============================================================================

# BLS Passphrase for key generation and node startup
# If not set, the container will prompt interactively (requires -it flag)
# SECURITY: Never commit this value to git!
TN_BLS_PASSPHRASE=

# ============================================================================
# Optional Configuration
# ============================================================================

# Git branch to build from when GIT_TAG is not set (default: main)
# Examples: main, develop, feature-branch-name
GIT_BRANCH=main

# Git tag to build from (preferred over GIT_BRANCH when set)
# Initial default for this project: v0.17.0-adiri
# Set to empty (GIT_TAG=) to build from GIT_BRANCH instead
GIT_TAG=v0.17.0-adiri

# Repository URL to clone during image builds (default: upstream repo)
# Override this to build from your fork or alternate clone URL
GIT_REPO_URL=https://github.com/telcoin-association/telcoin-network.git

# Data directory path (default: /app/data)
# This is where keys, config, and chain data are stored
DATADIR=/app/data

# Primary listener multiaddress (default: IPv6)
# IPv6 example: /ip6/::/udp/49590/quic-v1
# IPv4 example: /ip4/0.0.0.0/udp/49590/quic-v1
PRIMARY_LISTENER_MULTIADDR=/ip6/::/udp/49590/quic-v1

# Worker listener multiaddress (default: IPv6)
# IPv6 example: /ip6/::/udp/49594/quic-v1
# IPv4 example: /ip4/0.0.0.0/udp/49594/quic-v1
WORKER_LISTENER_MULTIADDR=/ip6/::/udp/49594/quic-v1

# Chain to connect to (default: adiri)
# Options: adiri (testnet), mainnet, etc.
CHAIN=adiri

# ============================================================================
# Azure VM Deployment (scripts/deploy-azure-vm.sh loads .env automatically)
# ============================================================================
# Fill these in before deploying. The resource group and ACR must already exist.
AZURE_SUBSCRIPTION_ID=
AZURE_RESOURCE_GROUP=oprail-telcoin-testnet
AZURE_LOCATION=eastus
ACR_NAME=oprailtelcoin
VM_NAME=telcoin-observer-vm-1
VM_SIZE=Standard_D4s_v6
# Zonal VM and data disks; each disk has 512 GiB, 5000 IOPS and 125 MB/s.
VM_ZONE=1
DATA_DISK_IOPS=5000
DATA_DISK_MBPS=125
VM_ADMIN_USERNAME=azureuser
# Globally unique DNS label, e.g. my-telcoin-observer-1
VM_DNS_LABEL=
# Restrict SSH to your public IP, e.g. 203.0.113.10/32
SSH_SOURCE_CIDR=
SSH_PUBLIC_KEY_FILE="$HOME/.ssh/id_ed25519.pub"
SSH_PRIVATE_KEY_FILE="$HOME/.ssh/id_ed25519"
# Uses GIT_TAG for the image tag unless IMAGE_TAG is specified.
IMAGE_REPO=telcoin-observer
IMAGE_TAG=
SKIP_IMAGE_BUILD=false

# Optional: matching snapshots from scripts/snapshot-azure-vm.sh; blank creates empty disks.
EXECUTION_SNAPSHOT_ID=
CONSENSUS_SNAPSHOT_ID=
# Optional unique snapshot name prefix; defaults to VM_NAME plus UTC timestamp.
SNAPSHOT_PREFIX=
# Public RPC URL advertised in the VM's discovery tags (does not open network ports).
PUBLIC_RPC_URL=
# Common reference for local/public-RPC and fleet monitoring.
NETWORK_RPC_URL=https://rpc.adiri.tel
# Experimental direct HTTP RPC ingress. Enable explicitly for experiments.
PUBLIC_RPC_ENABLED=false
PUBLIC_RPC_SOURCE_CIDR='*'

# HTTP and optional WebSocket RPC namespaces; VM service restart applies changes.
HTTP_API=eth,net,web3,rpc,debug,trace
WS_ENABLED=false
WS_API=eth,net,web3,rpc,debug,trace

# Optional private pool deployment (registry may live in a different group).
ACR_RESOURCE_GROUP=
EXISTING_SUBNET_ID=
BACKEND_POOL_ID=
PRIVATE_RPC_SOURCE_CIDRS=
# Required for pool readiness; verified Adiri chain ID is 0x7e1.
EXPECTED_CHAIN_ID=
# Pin a validated release digest; blank retains IMAGE_TAG behavior.
IMAGE_DIGEST=
